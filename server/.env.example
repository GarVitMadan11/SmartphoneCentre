# ─────────────────────────────────────────────────────────────────────────────
# Server Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Development: SQLite (file path resolved automatically if left as-is)
# Production: Must be a full PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=4000

# ── Admin Authentication — JWT ────────────────────────────────────────────────
# Generate a secure secret (minimum 32 chars, recommended 64):
#   node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET="REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_HEX_STRING"
JWT_EXPIRES_IN="4h"

# ── Admin PIN (optional) ─────────────────────────────────────────────────────
# If set, enables PIN-based admin login in addition to username/password.
# The plain-text PIN bypass has been removed — this MUST be a bcrypt hash.
# Generate a hash:
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('YOUR_PIN', 12));"
# Leave empty to disable PIN authentication entirely.
ADMIN_PIN_HASH=""

# ── Payout Data Encryption — AES-256-GCM ─────────────────────────────────────
# 32-byte (256-bit) key encoded as 64 lowercase hex characters.
# Generate:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# WARNING: Rotating this key will make all existing encrypted payout records unreadable.
PAYOUT_ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_STRING"

# ── Quote HMAC Signing ────────────────────────────────────────────────────────
# Separate from JWT_SECRET to prevent key misuse.
# Generate:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
# Falls back to JWT_SECRET if not set (not recommended for production).
QUOTE_SIGNING_SECRET="REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_HEX_STRING"

# ── AI Support (optional) ─────────────────────────────────────────────────────
# Google Gemini API key for the AI support chat assistant.
# Leave empty to use the built-in rule-based fallback.
GEMINI_API_KEY=""

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# The NODE_ENV bypass has been removed — this list is enforced in all environments.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://rephonix.in,https://www.rephonix.in"
