# ─── SERVER BACKEND CONFIGURATION (server/.env) ──────────────────────────────

PORT=4000
NODE_ENV=development

# Database URL (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT & Crypto Secrets
JWT_SECRET=your_jwt_super_secret_key_at_least_32_characters_long
PAYOUT_ENCRYPTION_KEY=your_aes256_encryption_hex_or_string_key

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_ALERT_EMAIL=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI API Key
GEMINI_API_KEY=

# ─── FIREBASE ADMIN SDK (CONFIDENTIAL — SERVER ENVIRONMENT ONLY) ────────────
# Obtain these from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
