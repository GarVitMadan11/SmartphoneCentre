generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  logo      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model Model {
  id                 String   @id @default(uuid())
  legacyId           String   @unique
  brandId            String
  name               String
  category           String
  releaseYear        Int
  basePrice128GB     Int
  series             String   @default("")
  imageUrl           String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  supportedRamGb     String   @default("[0]")
  supportedStorageGb String   @default("[128,256,512]")
  variantPrices      String   @default("{}")
  hidden             Boolean  @default(false)
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([category])
  @@index([series])
  @@index([releaseYear])
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  googleId                String?                  @unique
  picture                 String?
  bookings                Booking[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([email])
  @@index([googleId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminUser {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  passwordHash        String
  role                String    @default("OPERATIONS_AGENT")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLoginAt         DateTime?
  lockedUntil         DateTime?
}

model Quote {
  id              String   @id @default(uuid())
  modelLegacyId   String
  storageGb       Int
  defectIdsJson   String   @default("[]")
  calculatedPrice Int
  expiresAt       DateTime
  version         String   @default("v1.1.0")
  signature       String
  createdAt       DateTime @default(now())

  @@index([modelLegacyId])
  @@index([expiresAt])
}

model Booking {
  id                    String         @id
  modelLegacyId         String
  modelName             String
  storageGb             Int
  color                 String
  customerName          String
  customerPhone         String
  customerEmail         String
  address               String
  pickupDate            String
  pickupTimeSlot        String
  finalPrice            Int
  verificationStatus    String         @default("pending")
  isVerifiedProvider    Boolean        @default(false)
  verificationProofHash String         @default("")
  verifiedName          String         @default("")
  maskedAadhaar         String         @default("")
  verificationDate      String         @default("")
  payoutMethod          String
  payoutMethodName      String
  bonusPercentage       Float          @default(0)
  bonusAmount           Int            @default(0)
  finalPayoutAmount     Int
  inspectionStatus      String         @default("pending")
  payoutStatus          String         @default("pending")
  dateCreated           String
  adminNotes            String         @default("")
  payoutDetailsJson     String         @default("{}")
  defectIdsJson         String         @default("[]")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id])
  events                BookingEvent[]

  @@index([inspectionStatus])
  @@index([payoutStatus])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([userId])
}

model BookingEvent {
  id        String   @id @default(uuid())
  bookingId String
  eventType String
  fromValue String   @default("")
  toValue   String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @default("")
  action      String
  targetType  String
  targetId    String
  payload     String   @default("{}")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model SupportConversation {
  id             String           @id @default(uuid())
  customerId     String?
  customerName   String?
  customerEmail  String?
  detectedIntent String?
  status         String           @default("AI_ACTIVE")
  handoffReason  String?
  summary        String?
  collectedInfo  String           @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       SupportMessage[]

  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
