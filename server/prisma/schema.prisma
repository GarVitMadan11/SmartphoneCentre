generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  logo      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models    Model[]
}

model Model {
  id                 String   @id @default(uuid())
  legacyId           String   @unique
  brandId            String
  name               String
  category           String
  deviceType         String   @default("smartphones")
  releaseYear        Int
  basePrice128GB     Int
  series             String   @default("")
  imageUrl           String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  supportedRamGb     String   @default("[0]")
  supportedStorageGb String   @default("[128,256,512]")
  variantPrices      String   @default("{}")
  hidden             Boolean  @default(false)
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([deviceType])
  @@index([category])
  @@index([series])
  @@index([releaseYear])
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  googleId                String?                  @unique
  picture                 String?
  bookings                Booking[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([email])
  @@index([googleId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminUser {
  id                  String    @id @default(uuid())
  username            String    @unique
  email               String    @unique
  passwordHash        String
  role                String    @default("OPERATIONS_AGENT")
  permissions         String    @default("[]")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  failedLoginAttempts Int       @default(0)
  lastLoginAt         DateTime?
  lockedUntil         DateTime?
}

model Quote {
  id              String   @id @default(uuid())
  modelLegacyId   String
  storageGb       Int
  defectIdsJson   String   @default("[]")
  calculatedPrice Int
  expiresAt       DateTime
  version         String   @default("v1.1.0")
  signature       String
  createdAt       DateTime @default(now())

  @@index([modelLegacyId])
  @@index([expiresAt])
}

model Booking {
  id                    String         @id
  modelLegacyId         String
  modelName             String
  storageGb             Int
  color                 String
  customerName          String
  customerPhone         String
  customerEmail         String
  imei                  String         @default("")
  address               String
  pickupDate            String
  pickupTimeSlot        String
  finalPrice            Int
  verificationStatus    String         @default("pending")
  isVerifiedProvider    Boolean        @default(false)
  verificationProofHash String         @default("")
  verifiedName          String         @default("")
  maskedAadhaar         String         @default("")
  verificationDate      String         @default("")
  payoutMethod          String
  payoutMethodName      String
  appliedCoupon         String         @default("")
  bonusPercentage       Float          @default(0)
  bonusAmount           Int            @default(0)
  finalPayoutAmount     Int
  inspectionStatus      String         @default("pending")
  payoutStatus          String         @default("pending")
  dateCreated           String
  adminNotes            String         @default("")
  payoutDetailsJson     String         @default("{}")
  defectIdsJson         String         @default("[]")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id])
  events                BookingEvent[]

  @@index([inspectionStatus])
  @@index([payoutStatus])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([userId])
}

model BookingEvent {
  id        String   @id @default(uuid())
  bookingId String
  eventType String
  fromValue String   @default("")
  toValue   String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @default("")
  action      String
  targetType  String
  targetId    String
  payload     String   @default("{}")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model SupportConversation {
  id             String           @id @default(uuid())
  customerId     String?
  customerName   String?
  customerEmail  String?
  detectedIntent String?
  status         String           @default("AI_ACTIVE")
  handoffReason  String?
  summary        String?
  collectedInfo  String           @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       SupportMessage[]

  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String   @unique
  otp       String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CashifyPriceAlert {
  id              String   @id @default(uuid())
  modelId         String
  modelName       String
  brandName       String
  ramGb           Int      @default(0)
  storageGb       Int
  rephonixPrice   Int
  cashifyPrice    Int
  difference      Int      // rephonixPrice - cashifyPrice
  status          String   // 'INCREASED' | 'DECREASED' | 'STABLE'
  changeAmount    Int      @default(0) // change compared to previous Cashify quote
  alertDate       DateTime @default(now())
  reviewed        Boolean  @default(false)

  @@index([modelId])
  @@index([status])
  @@index([alertDate])
}

model ReferralCoupon {
  id             String        @id @default(uuid())
  code           String        @unique
  type           String        @default("FLAT") // "FLAT" (₹) or "PERCENT" (%)
  value          Float         // e.g. 500 (₹500) or 5 (5%)
  minDeviceValue Int           @default(0) // Minimum base price required to apply
  maxBonusCap    Int?          // Optional cap on bonus amount for PERCENT coupons (e.g. max ₹1500)
  maxTotalUses   Int           @default(100) // Total allowed redemptions (0 = unlimited)
  currentUses    Int           @default(0) // Count of redemptions
  maxUsesPerUser Int           @default(1) // Usually 1 use per customer/phone
  expiresAt      DateTime?     // Optional expiry date
  active         Boolean       @default(true)
  createdBy      String        @default("ADMIN")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  usages         CouponUsage[]

  @@index([code])
  @@index([active])
}

model CouponUsage {
  id            String         @id @default(uuid())
  couponId      String
  couponCode    String
  bookingId     String?        // Attached booking ID if completed
  customerPhone String         @default("")
  customerEmail String         @default("")
  customerName  String         @default("")
  basePrice     Int
  bonusCredited Int            // Actual extra ₹ given to customer
  finalPrice    Int            // basePrice + bonusCredited
  usedAt        DateTime       @default(now())
  coupon        ReferralCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponCode])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([usedAt])
}

model InventoryItem {
  id                  String    @id @default(uuid())
  barcode             String    @unique
  brand               String
  model               String
  variant             String    @default("") // e.g. "8GB / 128GB"
  storageGb           Int?
  ramGb               Int?
  color               String    @default("")
  imei                String    @default("") // IMEI / Serial number
  condition           String    @default("Good") // "Flawless", "Good", "Fair", "Needs Repair"
  buyingPrice         Int       // Purchase cost in INR
  buyingDate          DateTime  @default(now()) // When acquired
  boughtFrom          String    // Seller name / supplier / customer
  sellerPhone         String    @default("")
  sellerEmail         String    @default("")
  acquisitionChannel  String    @default("OFFLINE") // "ONLINE" | "OFFLINE"
  associatedBookingId String?   // optional reference to doorstep booking
  status              String    @default("IN_STOCK") // "IN_STOCK" | "SOLD" | "IN_REPAIR" | "RETURNED"
  sellingPrice        Int?      // Sale price in INR
  soldDate            DateTime? // When sold
  soldTo              String?   // Buyer name
  buyerContact        String?   // Buyer phone/email
  paymentMethod       String?   // "CASH", "UPI", "CARD", "BANK_TRANSFER"
  notes               String    @default("") // Remarks, accessories, condition notes
  createdBy           String    @default("ADMIN")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([barcode])
  @@index([status])
  @@index([acquisitionChannel])
  @@index([buyingDate])
  @@index([soldDate])
  @@index([imei])
}
